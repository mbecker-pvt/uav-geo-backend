# Copy to .env (git-ignored). All variables have defaults except DATABASE_URL.
DATABASE_URL=postgres://uav:uav@127.0.0.1:5432/uav
# MAVLink endpoint: PX4 SITL sends to UDP 14550 by default.
MAVLINK_ADDR=udpin:0.0.0.0:14550
HTTP_ADDR=127.0.0.1:8080
# GeoTIFF file or directory of tiles (EPSG:4326). Optional.
# DEM_PATH=data/dem
# GeoJSON Polygon/Feature used as initial active geofence. Optional.
# GEOFENCE_PATH=data/geofence.geojson
MIN_AGL_M=30
RUST_LOG=info,server=debug,telemetry=debug
